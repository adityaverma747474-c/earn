# Firebase Admin SDK (Server-side) - Get from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# TimeWall Offerwall
TIMEWALL_PUBLIC_ID=your-timewall-public-id
TIMEWALL_SECRET_KEY=your-timewall-secret-key
